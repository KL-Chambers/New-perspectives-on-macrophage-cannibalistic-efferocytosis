                RowBox[{"-", "r"}], "*", "idx"}], "]"}], ")"}], ")"}]}]}]}], 
         ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Eta]vec", "=", 
