Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Log", "-", 
    RowBox[{"likelihood", " ", "function"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "completeloglikelihood", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"completeloglikelihood", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
       RowBox[{"e_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Mu]_", "?", "NumericQ"}], ",", 
       RowBox[{"cv_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Beta]0_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Beta]1_", "?", "NumericQ"}], ",", 
       RowBox[{"q_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]M_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]m_", "?", "NumericQ"}]}], "}"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "imax", ",", "dx", ",", "tmax", ",", "n", ",", "idx", ",", "pmf", ",", 
        "\[Beta]vec", ",", "\[Eta]vec", ",", "fvec", ",", "fbar", ",", 
        "mInit", ",", "eqs", ",", "sol", ",", "Msol", ",", "moutput", ",", 
        "Moutput", ",", "Loutput", ",", "loglikelihoodM", ",", 
        "loglikelihoodm", ",", "outcome", ",", "\[Lambda]"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"rhsVecfunction", "[", 
         RowBox[{
          RowBox[{"v_", "?", "VectorQ"}], ",", 
          RowBox[{"\[Beta]vec_", "?", "VectorQ"}], ",", 
          RowBox[{"fvec_", "?", "VectorQ"}], ",", "ee_", ",", "fbar_", ",", 
          RowBox[{"idx_", "?", "VectorQ"}], ",", 
          RowBox[{"n_", "?", "IntegerQ"}], ",", 
          RowBox[{"afun_", "?", "NumericQ"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"betaBar", ",", "etaBar", ",", "alpha", ",", "conv"}], 
           "}"}], ",", " ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"Here", " ", "v"}], " ", "=", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"m", "[", "0", "]"}], ",", " ", 
              RowBox[{"m", "[", "1", "]"}], ",", " ", "...", ",", " ", 
              RowBox[{"m", "[", "imax", "]"}]}], " "}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"betaBar", "=", 
            RowBox[{"Dot", "[", 
             RowBox[{"\[Beta]vec", ",", "v"}], "]"}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{"<", "beta", ">"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"etaBar", "=", 
              RowBox[{"Dot", "[", 
               RowBox[{"\[Eta]vec", ",", "v"}], "]"}]}], ";"}], 
            RowBox[{"(*", " ", 
             RowBox[{"<", 
              SubscriptBox["\[Eta]", "l"], ">"}], "*)"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"alpha", "=", 
              RowBox[{"Dot", "[", 
               RowBox[{
                RowBox[{"\[Beta]vec", "*", 
                 RowBox[{"(", 
                  RowBox[{"ee", "+", "idx"}], ")"}]}], ",", "v"}], "]"}]}], 
             ";"}], 
            RowBox[{"(*", " ", 
             RowBox[{"<", 
              RowBox[{"beta_i", " ", 
               RowBox[{"(", 
                RowBox[{"e", "+", "i"}], ")"}]}], ">"}], "*)"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"conv", "=", 
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"Take", "[", 
               RowBox[{
                RowBox[{"ListConvolve", "[", 
                 RowBox[{"fvec", ",", "v", ",", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", 
                    RowBox[{"-", "1"}]}], "}"}], ",", "0"}], "]"}], ",", 
                RowBox[{"n", "-", "1"}]}], "]"}], ",", "0"}], "]"}]}], ";", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"conv", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
             RowBox[{
              RowBox[{"Sum_", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"j", "=", "1"}], "}"}], "^", "i"}], " ", "f_j", " ", 
               "\[Eta]_", 
               RowBox[{"{", 
                RowBox[{"i", "-", "j"}], "}"}], " ", "m_", 
               RowBox[{"{", 
                RowBox[{"i", "-", "j"}], "}"}], " ", "for", " ", "i"}], ">=", 
              "1"}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Eta]", "/", "\[Mu]"}], "*", "afun", " ", "*", 
             RowBox[{"(", 
              RowBox[{"conv", "-", "v"}], ")"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"betaBar", "-", "\[Beta]vec"}], ")"}], "*", "v"}]}]}]}],
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"imax", "=", "1000"}], ";", "\[IndentingNewLine]", 
       RowBox[{"tmax", "=", "60"}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"imax", "+", "1"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"idx", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "imax"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"Table", "[", 
              RowBox[{"\[Beta]0", ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"\[Beta]vec", "=", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"N", "@", 
          RowBox[{"(", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"\[Beta]0", "*", 
              RowBox[{"Exp", " ", "[", 
               RowBox[{"\[Beta]1", "*", "t"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
           ")"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"\[Beta]0", "*", 
                RowBox[{"Exp", " ", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"\[Beta]1", "*", "t"}], ")"}], "^", "2"}], "]"}]}],
                ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"\[Beta]0", "*", 
                RowBox[{"Exp", " ", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"\[Beta]1", "*", "t"}], ")"}], "^", 
                  RowBox[{"(", 
                   RowBox[{"1", "/", "2"}], ")"}]}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"\[Beta]0", "+", 
              RowBox[{"\[Beta]1", "*", "idx"}]}], ")"}]}]}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"\[Beta]1", "/", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"\[Beta]1", "-", "\[Beta]0"}], ")"}], "/", 
                    "\[Beta]0"}], "*", 
                   RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "t"}], "/", "q"}], "]"}]}]}], ")"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"\[Beta]1", "/", 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"\[Beta]1", "-", "\[Beta]0"}], ")"}], "/", 
                  "\[Beta]0"}], "*", 
                 RowBox[{"Exp", "[", 
                  RowBox[{
                   RowBox[{"-", "idx"}], "/", "q"}], "]"}]}]}], ")"}]}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"(", 
              RowBox[{"\[Beta]0", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"\[Beta]1", "-", "\[Beta]0"}], ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"Exp", "[", 
                   RowBox[{
                    RowBox[{"-", "idx"}], "/", "q"}], "]"}]}], ")"}]}]}], 
              ")"}], ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"\[Beta]0", "+", 
              RowBox[{"\[Beta]1", "*", 
               RowBox[{"idx", "^", "q"}]}]}], ")"}]}]}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Eta]vec", "=", 
          RowBox[{
           RowBox[{"A", "[", "t", "]"}], "*", 
           RowBox[{"Developer`ToPackedArray", "@", 
            RowBox[{"N", "@", 
             RowBox[{"(", 
              RowBox[{"Table", "[", 
               RowBox[{"\[Eta]val", ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "1", ",", 
                  RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
              ")"}]}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
