Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Log", "-", 
    RowBox[{"likelihood", " ", "function"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "loglikelihood", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"loglikelihood", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"e_", "?", "NumericQ"}], ",", 
       RowBox[{"cv_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Beta]0_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Beta]1_", "?", "NumericQ"}], ",", 
       RowBox[{"q_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]M_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]m_", "?", "NumericQ"}]}], "}"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "imax", ",", "dx", ",", "tmax", ",", "n", ",", "idx", ",", "pmf", ",", 
        "\[Beta]vec", ",", "\[Eta]vec", ",", "fvec", ",", "fbar", ",", 
        "mInit", ",", "eqs", ",", "sol", ",", "Msol", ",", "moutput", ",", 
        "Moutput", ",", "loglikelihoodm", ",", "loglikelihoodM", ",", 
        "loglikelihoodL", ",", "outcome", ",", "\[Lambda]", ",", "Loutput"}], 
       "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"rhsVecfunction", "[", 
         RowBox[{
          RowBox[{"v_", "?", "VectorQ"}], ",", 
          RowBox[{"\[Beta]vec_", "?", "VectorQ"}], ",", 
          RowBox[{"n_", "?", "IntegerQ"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "h"}], "}"}], ",", " ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"Here", " ", "v"}], " ", "=", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"m", "[", "0", "]"}], ",", " ", 
              RowBox[{"m", "[", "1", "]"}], ",", " ", "...", ",", " ", 
              RowBox[{"m", "[", "imax", "]"}]}], " "}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"x", "=", 
            RowBox[{"\[Beta]vec", "*", "v"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"h", "=", 
            RowBox[{"ListConvolve", "[", 
             RowBox[{"fvec", ",", 
              RowBox[{"ListConvolve", "[", 
               RowBox[{"x", ",", "v", ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"-", "1"}]}], "}"}], ",", "0"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"-", "1"}]}], "}"}], ",", "0"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Take", "[", 
             RowBox[{"h", ",", "n"}], "]"}], "-", "x"}]}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"pmf", "[", 
         RowBox[{
          RowBox[{"i_", "?", "NumericQ"}], ",", 
          RowBox[{"\[Mu]_", "?", "NumericQ"}], ",", 
          RowBox[{"sig_", "?", "NumericQ"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "\[Sigma]2", ",", "\[Mu]Log", ",", "\[Sigma]Log", ",", "dist"}], 
           "}"}], ",", 
          RowBox[{
           RowBox[{"\[Sigma]2", "=", 
            RowBox[{"Log", "[", 
             RowBox[{"1", "+", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"sig", "^", "2"}], "/", 
                RowBox[{"\[Mu]", "^", "2"}]}], ")"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"\[Mu]Log", "=", 
            RowBox[{
             RowBox[{"Log", "[", "\[Mu]", "]"}], "-", 
             RowBox[{"\[Sigma]2", "/", "2"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"\[Sigma]Log", "=", 
            RowBox[{"Sqrt", "[", "\[Sigma]2", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"dist", "=", 
            RowBox[{"LogNormalDistribution", "[", 
             RowBox[{"\[Mu]Log", ",", "\[Sigma]Log"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"CDF", "[", 
             RowBox[{"dist", ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "-", 
            RowBox[{"CDF", "[", 
             RowBox[{"dist", ",", "i"}], "]"}]}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"imax", "=", "1000"}], ";", "\[IndentingNewLine]", 
       RowBox[{"tmax", "=", "50"}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"imax", "+", "1"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"idx", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "imax"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"Table", "[", 
              RowBox[{"\[Beta]0", ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"\[Beta]0", "*", 
                RowBox[{"Exp", "[", 
                 RowBox[{"\[Beta]1", "*", "t"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"\[Beta]0", "+", 
              RowBox[{"\[Beta]1", "*", "idx"}]}], ")"}]}]}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"\[Beta]1", "/", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"\[Beta]1", "-", "\[Beta]0"}], ")"}], "/", 
                    "\[Beta]0"}], "*", 
                   RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "t"}], "/", "q"}], "]"}]}]}], ")"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"\[Beta]vec", "=", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"N", "@", 
          RowBox[{"(", 
           RowBox[{"(", 
            RowBox[{"\[Beta]0", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\[Beta]1", "-", "\[Beta]0"}], ")"}], "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", "idx"}], "/", "q"}], "]"}]}], ")"}]}]}], ")"}],
            ")"}]}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Eta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"Table", "[", 
              RowBox[{"1", ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Eta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"(", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "r"}], "*", "idx"}], "]"}], ")"}], ")"}]}]}]}], 
         ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Eta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"(", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "r"}], "*", 
                RowBox[{"idx", "^", "2"}]}], "]"}], ")"}], ")"}]}]}]}], ";"}],
         "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"fvec", "=", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"N", "@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"pmf", "[", 
              RowBox[{"#", ",", "e", ",", 
               RowBox[{"cv", "*", "e"}]}], "]"}], "&"}], "/@", 
            RowBox[{"(", 
             RowBox[{"idx", "+", "1"}], ")"}]}], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"mInit", "=", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"N", "@", 
          RowBox[{"PadRight", "[", 
           RowBox[{
            RowBox[{"resamplet0", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "n", ",", "0"}], 
           "]"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"eqs", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"u", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"rhsVecfunction", "[", 
            RowBox[{
             RowBox[{"u", "[", "t", "]"}], ",", "\[Beta]vec", ",", "n"}], 
            "]"}]}], ",", 
          RowBox[{
           RowBox[{"u", "[", "0", "]"}], "==", "mInit"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"M", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"M", "[", "t", "]"}]}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Beta]vec", ".", 
               RowBox[{"u", "[", "t", "]"}]}], "+", 
              RowBox[{
               RowBox[{"Last", "[", "\[Beta]vec", "]"}], "*", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"Total", "[", 
                  RowBox[{"u", "[", "t", "]"}], "]"}]}], ")"}]}]}], ")"}]}]}],
           ",", 
          RowBox[{
           RowBox[{"M", "[", "0", "]"}], "==", "1"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"outcome", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"eqs", ",", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"u", "[", "t", "]"}], "]"}], "<", "0.99"}], ",", 
              RowBox[{"\"\<StopIntegration\>\"", ";", 
               RowBox[{"outcome", "=", "1"}]}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "M"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"moutput", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"u", "[", "t", "]"}], "/.", " ", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "12", ",", "24", ",", "36", ",", "48"}], 
             "}"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Moutput", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"M", "[", "t", "]"}], "/.", " ", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "12", ",", "24", ",", "36", ",", "48"}], 
             "}"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Loutput", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"idx", ".", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"u", "[", "t", "]"}], "/.", " ", 
             RowBox[{"sol", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "12", ",", "24", ",", "36", ",", "48"}], 
             "}"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"loglikelihoodM", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Mdata", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{
                 RowBox[{"Mdata", "[", 
