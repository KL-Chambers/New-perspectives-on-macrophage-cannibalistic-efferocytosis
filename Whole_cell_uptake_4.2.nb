    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"negbinom", "[", 
     RowBox[{"i_", ",", "\[Mu]_", ",", "cv_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "p"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Mu]", "-", "1"}], ")"}], "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"cv", "^", "2"}], "*", 
            RowBox[{"\[Mu]", "^", "2"}]}], "-", "\[Mu]", "+", "1"}], 
          ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"p", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Mu]", "-", "1"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"cv", "^", "2"}], "*", 
           RowBox[{"\[Mu]", "^", "2"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"i", "+", "r", "-", "2"}], ",", 
          RowBox[{"i", "-", "1"}]}], "]"}], "*", 
        RowBox[{"p", "^", "r"}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"i", "-", "1"}], ")"}]}]}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"decay", "[", 
     RowBox[{
      RowBox[{"i_", "?", "IntegerQ"}], ",", "a_", ",", "b_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "p"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"k", "=", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"N", "@", 
              RowBox[{"(", "j", ")"}]}], "^", 
             RowBox[{"(", 
              RowBox[{"-", "b"}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", "1000"}], "}"}]}], "]"}], ";"}], 
         "*)"}], 
        RowBox[{"Zeta", "[", "b", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "k"}], ")"}], "*", 
        RowBox[{
         RowBox[{"(", "i", ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"-", "b"}], ")"}]}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"logit", "[", "x_", "]"}], ":=", 
     RowBox[{"Log", "[", 
      RowBox[{"x", "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", "x"}], ")"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"invlogit", "[", "x_", "]"}], ":=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", "x"}], "]"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.997701698475546*^9, 3.9977016986178875`*^9}},
