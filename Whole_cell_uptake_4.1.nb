Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Log", "-", 
    RowBox[{"likelihood", " ", "function"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "loglikelihood", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"loglikelihood", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"e_", "?", "NumericQ"}], ",", 
       RowBox[{"cv_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Beta]0_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Beta]1_", "?", "NumericQ"}], ",", 
       RowBox[{"q_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]M_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]L_", "?", "NumericQ"}]}], "}"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "imax", ",", "dx", ",", "tmax", ",", "n", ",", "idx", ",", "pmf", ",", 
        "\[Beta]vec", ",", "\[Eta]vec", ",", "fvec", ",", "fbar", ",", 
        "mInit", ",", "eqs", ",", "sol", ",", "Msol", ",", "moutput", ",", 
        "Moutput", ",", "loglikelihoodm", ",", "loglikelihoodM", ",", 
        "loglikelihoodL", ",", "outcome", ",", "\[Lambda]", ",", "Loutput"}], 
       "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"rhsVecfunction", "[", 
         RowBox[{
          RowBox[{"v_", "?", "VectorQ"}], ",", 
          RowBox[{"\[Beta]vec_", "?", "VectorQ"}], ",", 
          RowBox[{"n_", "?", "IntegerQ"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "h"}], "}"}], ",", " ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"Here", " ", "v"}], " ", "=", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"m", "[", "0", "]"}], ",", " ", 
              RowBox[{"m", "[", "1", "]"}], ",", " ", "...", ",", " ", 
              RowBox[{"m", "[", "imax", "]"}]}], " "}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"x", "=", 
            RowBox[{"\[Beta]vec", "*", "v"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"h", "=", 
            RowBox[{"ListConvolve", "[", 
             RowBox[{"fvec", ",", 
              RowBox[{"ListConvolve", "[", 
               RowBox[{"x", ",", "v", ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"-", "1"}]}], "}"}], ",", "0"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"-", "1"}]}], "}"}], ",", "0"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Take", "[", 
             RowBox[{"h", ",", "n"}], "]"}], "-", "x"}]}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"pmf", "[", 
         RowBox[{
          RowBox[{"i_", "?", "NumericQ"}], ",", 
          RowBox[{"\[Mu]_", "?", "NumericQ"}], ",", 
          RowBox[{"sig_", "?", "NumericQ"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
