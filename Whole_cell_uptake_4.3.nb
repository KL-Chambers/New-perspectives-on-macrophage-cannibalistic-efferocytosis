Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Log", "-", 
    RowBox[{"likelihood", " ", "function"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "loglikelihood", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"loglikelihood", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
       RowBox[{"e_", "?", "NumericQ"}], ",", 
       RowBox[{"cv_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Beta]0_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Beta]1_", "?", "NumericQ"}], ",", 
       RowBox[{"q_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]M_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]m_", "?", "NumericQ"}]}], "}"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "imax", ",", "dx", ",", "tmax", ",", "n", ",", "idx", ",", "pmf", ",", 
        "\[Beta]vec", ",", "\[Eta]vec", ",", "fvec", ",", "fbar", ",", 
        "mInit", ",", "eqs", ",", "sol", ",", "Msol", ",", "moutput", ",", 
        "Moutput", ",", "loglikelihoodm", ",", "loglikelihoodM", ",", 
        "loglikelihoodL", ",", "outcome", ",", "\[Lambda]", ",", "Loutput", ",",
         "mRHSfunction", ",", "pInit"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"imax", "=", "1000"}], ";", "\[IndentingNewLine]", 
       RowBox[{"tmax", "=", "60"}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"imax", "+", "1"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"idx", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "imax"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rhsVecfunction", "[", 
         RowBox[{
          RowBox[{"v_", "?", "VectorQ"}], ",", 
          RowBox[{"w_", "?", "VectorQ"}], ",", "P_", ",", 
          RowBox[{"\[Beta]vec_", "?", "VectorQ"}], ",", 
          RowBox[{"n_", "?", "IntegerQ"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "h"}], "}"}], ",", " ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"Here", " ", "v"}], " ", "=", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"m", "[", "0", "]"}], ",", " ", 
              RowBox[{"m", "[", "1", "]"}], ",", " ", "...", ",", " ", 
              RowBox[{"m", "[", "imax", "]"}], ",", " ", 
              RowBox[{"w", " ", "=", " ", "p"}]}], " "}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"h", "=", 
            RowBox[{"ListConvolve", "[", 
             RowBox[{"fvec", ",", 
              RowBox[{"ListConvolve", "[", 
               RowBox[{"w", ",", "v", ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"-", "1"}]}], "}"}], ",", "0"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"-", "1"}]}], "}"}], ",", "0"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\[Eta]", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Take", "[", 
                RowBox[{"h", ",", "n"}], "]"}], "-", 
               RowBox[{"P", "*", "v"}]}], ")"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[Beta]vec", ".", "v"}], " ", "-", " ", 
               "\[Beta]vec"}], ")"}], "*", "v"}]}]}]}], "\[IndentingNewLine]",
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"pRHSfunction", "[", 
         RowBox[{
          RowBox[{"v_", "?", "VectorQ"}], ",", 
          RowBox[{"w_", "?", "VectorQ"}], ",", "MM_", ",", 
          RowBox[{"\[Beta]vec_", "?", "VectorQ"}]}], "]"}], ":=", 
        RowBox[{"MM", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Beta]vec", "*", "v"}], "-", 
           RowBox[{"\[Eta]", "*", "w"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"pmf", "[", 
         RowBox[{
          RowBox[{"i_", "?", "NumericQ"}], ",", 
          RowBox[{"\[Mu]_", "?", "NumericQ"}], ",", 
          RowBox[{"sig_", "?", "NumericQ"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "\[Sigma]2", ",", "\[Mu]Log", ",", "\[Sigma]Log", ",", "dist"}], 
           "}"}], ",", 
          RowBox[{
           RowBox[{"\[Sigma]2", "=", 
            RowBox[{"Log", "[", 
             RowBox[{"1", "+", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"sig", "^", "2"}], "/", 
                RowBox[{"\[Mu]", "^", "2"}]}], ")"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"\[Mu]Log", "=", 
            RowBox[{
             RowBox[{"Log", "[", "\[Mu]", "]"}], "-", 
             RowBox[{"\[Sigma]2", "/", "2"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"\[Sigma]Log", "=", 
            RowBox[{"Sqrt", "[", "\[Sigma]2", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"dist", "=", 
            RowBox[{"LogNormalDistribution", "[", 
             RowBox[{"\[Mu]Log", ",", "\[Sigma]Log"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"CDF", "[", 
             RowBox[{"dist", ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "-", 
            RowBox[{"CDF", "[", 
             RowBox[{"dist", ",", "i"}], "]"}]}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", "beta_l", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"Table", "[", 
              RowBox[{"\[Beta]0", ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"\[Beta]0", "*", 
                RowBox[{"Exp", "[", 
                 RowBox[{"\[Beta]1", "*", "t"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"\[Beta]0", "+", 
              RowBox[{"\[Beta]1", "*", "idx"}]}], ")"}]}]}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"\[Beta]1", "/", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"\[Beta]1", "-", "\[Beta]0"}], ")"}], "/", 
                    "\[Beta]0"}], "*", 
                   RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "t"}], "/", "q"}], "]"}]}]}], ")"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"\[Beta]vec", "=", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"N", "@", 
          RowBox[{"(", 
           RowBox[{"(", 
            RowBox[{"\[Beta]0", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\[Beta]1", "-", "\[Beta]0"}], ")"}], "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", "idx"}], "/", "q"}], "]"}]}], ")"}]}]}], ")"}],
            ")"}]}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "eta_l", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"\[Eta]vec", "=", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"N", "@", 
          RowBox[{"Table", "[", 
           RowBox[{"\[Eta]", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fvec", "=", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"N", "@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"pmf", "[", 
              RowBox[{"#", ",", "e", ",", 
               RowBox[{"cv", "*", "e"}]}], "]"}], "&"}], "/@", 
            RowBox[{"(", 
             RowBox[{"idx", "+", "1"}], ")"}]}], ")"}]}]}]}], ";", " ", 
       RowBox[{"(*", "g_l", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"mInit", "=", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"N", "@", 
          RowBox[{"PadRight", "[", 
           RowBox[{
            RowBox[{"resamplet0", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "n", ",", "0"}], 
           "]"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pInit", "=", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.", ",", "n"}], "]"}]}]}], ";", "\n", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"eqs", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"u", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"rhsVecfunction", "[", 
            RowBox[{
             RowBox[{"u", "[", "t", "]"}], ",", 
             RowBox[{"p", "[", "t", "]"}], ",", 
             RowBox[{"P", "[", "t", "]"}], ",", "\[Beta]vec", ",", "n"}], 
            "]"}]}], ",", 
          RowBox[{
           RowBox[{"u", "[", "0", "]"}], "==", "mInit"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"p", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"pRHSfunction", "[", 
            RowBox[{
             RowBox[{"u", "[", "t", "]"}], ",", 
             RowBox[{"p", "[", "t", "]"}], ",", 
             RowBox[{"M", "[", "t", "]"}], ",", "\[Beta]vec"}], "]"}]}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"p", "'"}], "[", "t", "]"}], "==", 
             RowBox[{
              RowBox[{"M", "[", "t", "]"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"\[Beta]vec", "*", 
                 RowBox[{"u", "[", "t", "]"}]}], "-", 
                RowBox[{"\[Eta]", "*", 
                 RowBox[{"p", "[", "t", "]"}]}]}], ")"}]}]}], ","}], "*)"}], 
          RowBox[{
           RowBox[{"p", "[", "0", "]"}], "==", "pInit"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"M", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"M", "[", "t", "]"}]}], "*", 
            RowBox[{"(", 
             RowBox[{"\[Beta]vec", ".", 
              RowBox[{"u", "[", "t", "]"}]}], ")"}]}]}], ",", 
          RowBox[{
           RowBox[{"M", "[", "0", "]"}], "==", "1"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"P", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[Beta]vec", ".", 
               RowBox[{"u", "[", "t", "]"}]}], ")"}], "*", 
             RowBox[{"M", "[", "t", "]"}]}], "-", 
            RowBox[{"\[Eta]", "*", 
             RowBox[{"M", "[", "t", "]"}], "*", 
             RowBox[{"P", "[", "t", "]"}]}]}]}], ",", 
          RowBox[{
           RowBox[{"P", "[", "0", "]"}], "==", "0"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
       RowBox[{"outcome", "=", "0"}], ";", "\[IndentingNewLine]", "\n", 
       RowBox[{"sol", "=", 
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"eqs", ",", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"u", "[", "t", "]"}], "]"}], "<", "0.99"}], ",", 
              RowBox[{"\"\<StopIntegration\>\"", ";", "\[IndentingNewLine]", 
               RowBox[{"outcome", "=", "1"}]}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "p", ",", "M", ",", "P"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"moutput", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"u", "[", "t", "]"}], "/.", " ", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"{", 
             RowBox[{
             "0", ",", "12", ",", "24", ",", "36", ",", "48", ",", "60"}], 
             "}"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Moutput", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"M", "[", "t", "]"}], "/.", " ", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"{", 
             RowBox[{
             "0", ",", "12", ",", "24", ",", "36", ",", "48", ",", "60"}], 
             "}"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Loutput", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"idx", ".", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"u", "[", "t", "]"}], "/.", " ", 
             RowBox[{"sol", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"{", 
             RowBox[{
             "0", ",", "12", ",", "24", ",", "36", ",", "48", ",", "60"}], 
             "}"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"loglikelihoodM", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Mdata", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{
                 RowBox[{"Mdata", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "*", "\[Sigma]M", "*", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"2", " ", "Pi"}], "]"}]}], "]"}]}], "-", 
           RowBox[{
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"2", "*", 
               RowBox[{"\[Sigma]M", "^", "2"}]}], ")"}]}], "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Mdata", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{
                    RowBox[{"Mdata", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "]"}], "-", 
               RowBox[{"Log", "[", 
                RowBox[{
                 RowBox[{"Moutput", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{"Moutput", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], "]"}]}], ")"}],
              "^", "2"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2", ",", "6"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"loglikelihoodm", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"Length", "[", 
             RowBox[{"resamples", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "*", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Log", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"resamples", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "*", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"resamples", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "*", 
                 RowBox[{"(", 
                  RowBox[{"\[Sigma]m", "*", 
                   RowBox[{"Sqrt", "[", 
                    RowBox[{"12", "*", 
                    RowBox[{"(", 
                    RowBox[{"j", "-", "1"}], ")"}]}], "]"}]}], ")"}], "*", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"2", " ", "Pi"}], "]"}]}], "]"}]}], "-", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"(", 
                 RowBox[{"2", "*", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"\[Sigma]m", "*", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"12", "*", 
                    RowBox[{"(", 
                    RowBox[{"j", "-", "1"}], ")"}]}], "]"}]}], ")"}], "^", 
                   "2"}]}], ")"}]}], "*", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Log", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"resamples", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"resamples", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "]"}], "-", 
                  RowBox[{"Log", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"moutput", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"Round", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"resamples", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "+", "1"}], "]"}], 
                    "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{
                    RowBox[{"moutput", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"Round", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"resamples", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "+", "1"}], "]"}], 
                    "]"}]}], ")"}]}], "]"}]}], ")"}], "^", "2"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", 
                RowBox[{"resamples", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
