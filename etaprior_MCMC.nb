Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Log", "-", 
    RowBox[{"likelihood", " ", "function"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Log", "-", 
    RowBox[{"likelihood", " ", "function"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "completeloglikelihood", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"completeloglikelihood", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
       RowBox[{"e_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Mu]_", "?", "NumericQ"}], ",", 
       RowBox[{"cv_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Beta]0_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Beta]1_", "?", "NumericQ"}], ",", 
       RowBox[{"q_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]M_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]m_", "?", "NumericQ"}]}], "}"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "imax", ",", "dx", ",", "tmax", ",", "n", ",", "idx", ",", "pmf", ",", 
        "\[Beta]vec", ",", "\[Eta]vec", ",", "fvec", ",", "fbar", ",", 
        "mInit", ",", "eqs", ",", "sol", ",", "Msol", ",", "moutput", ",", 
        "Moutput", ",", "Loutput", ",", "loglikelihoodM", ",", 
        "loglikelihoodm", ",", "outcome", ",", "\[Lambda]", ",", "w"}], "}"}],
       ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"rhsVecfunction", "[", 
         RowBox[{
          RowBox[{"v_", "?", "VectorQ"}], ",", 
          RowBox[{"\[Beta]vec_", "?", "VectorQ"}], ",", 
          RowBox[{"fvec_", "?", "VectorQ"}], ",", "ee_", ",", "fbar_", ",", 
          RowBox[{"idx_", "?", "VectorQ"}], ",", 
          RowBox[{"n_", "?", "IntegerQ"}], ",", 
          RowBox[{"afun_", "?", "NumericQ"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"betaBar", ",", "etaBar", ",", "alpha", ",", "conv"}], 
           "}"}], ",", " ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"Here", " ", "v"}], " ", "=", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"m", "[", "0", "]"}], ",", " ", 
              RowBox[{"m", "[", "1", "]"}], ",", " ", "...", ",", " ", 
              RowBox[{"m", "[", "imax", "]"}]}], " "}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"betaBar", "=", 
            RowBox[{"Dot", "[", 
             RowBox[{"\[Beta]vec", ",", "v"}], "]"}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{"<", "beta", ">"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"etaBar", "=", 
              RowBox[{"Dot", "[", 
               RowBox[{"\[Eta]vec", ",", "v"}], "]"}]}], ";"}], 
            RowBox[{"(*", " ", 
             RowBox[{"<", 
              SubscriptBox["\[Eta]", "l"], ">"}], "*)"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"alpha", "=", 
              RowBox[{"Dot", "[", 
               RowBox[{
                RowBox[{"\[Beta]vec", "*", 
                 RowBox[{"(", 
                  RowBox[{"ee", "+", "idx"}], ")"}]}], ",", "v"}], "]"}]}], 
             ";"}], 
            RowBox[{"(*", " ", 
             RowBox[{"<", 
              RowBox[{"beta_i", " ", 
               RowBox[{"(", 
                RowBox[{"e", "+", "i"}], ")"}]}], ">"}], "*)"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"conv", "=", 
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"Take", "[", 
               RowBox[{
                RowBox[{"ListConvolve", "[", 
                 RowBox[{"fvec", ",", "v", ",", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", 
                    RowBox[{"-", "1"}]}], "}"}], ",", "0"}], "]"}], ",", 
                RowBox[{"n", "-", "1"}]}], "]"}], ",", "0"}], "]"}]}], ";", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"conv", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
             RowBox[{
              RowBox[{"Sum_", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"j", "=", "1"}], "}"}], "^", "i"}], " ", "f_j", " ", 
               "\[Eta]_", 
               RowBox[{"{", 
                RowBox[{"i", "-", "j"}], "}"}], " ", "m_", 
               RowBox[{"{", 
                RowBox[{"i", "-", "j"}], "}"}], " ", "for", " ", "i"}], ">=", 
              "1"}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Eta]", "/", "\[Mu]"}], "*", "afun", " ", "*", 
             RowBox[{"(", 
              RowBox[{"conv", "-", "v"}], ")"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"betaBar", "-", "\[Beta]vec"}], ")"}], "*", "v"}]}]}]}],
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"imax", "=", "1000"}], ";", "\[IndentingNewLine]", 
       RowBox[{"tmax", "=", "60"}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"imax", "+", "1"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"idx", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "imax"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"Table", "[", 
              RowBox[{"\[Beta]0", ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"\[Beta]vec", "=", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"N", "@", 
          RowBox[{"(", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"\[Beta]0", "*", 
              RowBox[{"Exp", " ", "[", 
               RowBox[{"\[Beta]1", "*", "t"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
           ")"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"\[Beta]1", "/", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"\[Beta]1", "-", "\[Beta]0"}], ")"}], "/", 
                    "\[Beta]0"}], "*", 
                   RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "t"}], "/", "q"}], "]"}]}]}], ")"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "idx", "]"}]}], "}"}]}], "]"}], 
             ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"\[Beta]0", "+", 
              RowBox[{"\[Beta]1", "*", "idx"}]}], ")"}]}]}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[Beta]vec", "=", 
          RowBox[{"Developer`ToPackedArray", "@", 
           RowBox[{"N", "@", 
            RowBox[{"(", 
             RowBox[{"(", 
              RowBox[{"\[Beta]0", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"\[Beta]1", "-", "\[Beta]0"}], ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"Exp", "[", 
                   RowBox[{
                    RowBox[{"-", "idx"}], "/", "q"}], "]"}]}], ")"}]}]}], 
              ")"}], ")"}]}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"fvec", "=", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"N", "@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"negbinom", "[", 
              RowBox[{"#", ",", "\[Mu]", ",", "cv"}], "]"}], 
             RowBox[{"(*", 
              RowBox[{"pmf", "[", 
               RowBox[{"#", ",", "\[Lambda]"}], "]"}], "*)"}], "&"}], "/@", 
            RowBox[{"(", 
             RowBox[{"idx", "+", "1"}], ")"}]}], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"mInit", "=", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"N", "@", 
          RowBox[{"PadRight", "[", 
           RowBox[{
            RowBox[{"resamplet0", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "n", ",", "0"}], 
           "]"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"eqs", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"u", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"rhsVecfunction", "[", 
            RowBox[{
             RowBox[{"u", "[", "t", "]"}], ",", "\[Beta]vec", ",", "fvec", ",",
              "e", ",", "\[Mu]", ",", "idx", ",", "n", ",", 
             RowBox[{"A", "[", "t", "]"}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"u", "[", "0", "]"}], "==", "mInit"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"M", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"M", "[", "t", "]"}]}], " ", 
            RowBox[{"(", 
             RowBox[{"\[Beta]vec", ".", 
              RowBox[{"u", "[", "t", "]"}]}], ")"}]}]}], ",", 
          RowBox[{
           RowBox[{"M", "[", "0", "]"}], "==", "1"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"A", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"M", "[", "t", "]"}], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Dot", "[", 
               RowBox[{
                RowBox[{"\[Beta]vec", "*", 
                 RowBox[{"(", 
                  RowBox[{"e", "+", "idx"}], ")"}]}], ",", 
                RowBox[{"u", "[", "t", "]"}]}], "]"}], "-", 
              RowBox[{"\[Eta]", "*", 
               RowBox[{"A", "[", "t", "]"}]}]}], ")"}]}]}], ",", " ", 
          RowBox[{
           RowBox[{"A", "[", "0", "]"}], "==", "0"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"outcome", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"eqs", ",", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Total", "[", 
                 RowBox[{"u", "[", "t", "]"}], "]"}], "<", "0.99"}], "||", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"M", "[", "t", "]"}], "<", "0.01"}], "&&", 
                 RowBox[{"t", "<", "55"}]}], ")"}]}], ",", 
              RowBox[{"\"\<StopIntegration\>\"", ";", 
               RowBox[{"outcome", "=", "1"}]}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "M", ",", " ", "A"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"moutput", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"u", "[", "t", "]"}], "/.", " ", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"{", 
             RowBox[{
             "0", ",", "12", ",", "24", ",", "36", ",", "48", ",", "60"}], 
             "}"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Moutput", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"M", "[", "t", "]"}], "/.", " ", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"{", 
             RowBox[{
             "0", ",", "12", ",", "24", ",", "36", ",", "48", ",", "60"}], 
             "}"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Loutput", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"idx", ".", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"u", "[", "t", "]"}], "/.", " ", 
             RowBox[{"sol", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"{", 
             RowBox[{
             "0", ",", "12", ",", "24", ",", "36", ",", "48", ",", "60"}], 
             "}"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"loglikelihoodM", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Mdata", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{
                 RowBox[{"Mdata", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "*", "\[Sigma]M", "*", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"2", " ", "Pi"}], "]"}]}], "]"}]}], "-", 
           RowBox[{
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"2", "*", 
               RowBox[{"\[Sigma]M", "^", "2"}]}], ")"}]}], "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Mdata", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{
                    RowBox[{"Mdata", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "]"}], "-", 
               RowBox[{"Log", "[", 
                RowBox[{
                 RowBox[{"Moutput", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{"Moutput", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], "]"}]}], ")"}],
              "^", "2"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2", ",", "6"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"loglikelihoodm", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"Length", "[", 
             RowBox[{"resamples", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "*", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Log", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"resamples", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "*", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"resamples", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "*", 
                 RowBox[{"(", 
                  RowBox[{"\[Sigma]m", "*", 
                   RowBox[{"Sqrt", "[", 
                    RowBox[{"12", "*", 
                    RowBox[{"(", 
                    RowBox[{"j", "-", "1"}], ")"}]}], "]"}]}], ")"}], "*", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"2", " ", "Pi"}], "]"}]}], "]"}]}], "-", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"(", 
                 RowBox[{"2", "*", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"\[Sigma]m", "*", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"12", "*", 
                    RowBox[{"(", 
                    RowBox[{"j", "-", "1"}], ")"}]}], "]"}]}], ")"}], "^", 
                   "2"}]}], ")"}]}], "*", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Log", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"resamples", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"resamples", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "]"}], "-", 
                  RowBox[{"Log", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"moutput", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"Round", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"resamples", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "+", "1"}], "]"}], 
                    "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{
                    RowBox[{"moutput", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"Round", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"resamples", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "+", "1"}], "]"}], 
                    "]"}]}], ")"}]}], "]"}]}], ")"}], "^", "2"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", 
                RowBox[{"resamples", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "2", ",", "6"}], "}"}]}], "]"}]}], ";", "\n", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
