   RowBox[{"MCMC", " ", "functions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"makePositiveDefinite", "[", 
      RowBox[{
       RowBox[{"mat_", "?", "MatrixQ"}], ",", 
       RowBox[{"tol_", ":", "1.*^-12"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sym", ",", "evMin"}], "}"}], ",", 
       RowBox[{
        RowBox[{"sym", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"mat", "+", 
            RowBox[{"Transpose", "[", "mat", "]"}]}], ")"}], "/", "2"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"evMin", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"Re", "[", 
           RowBox[{"Eigenvalues", "[", "sym", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"evMin", ">", "tol"}], ",", "sym", ",", 
          RowBox[{"sym", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "evMin"}], "+", "tol"}], ")"}], " ", 
            RowBox[{"IdentityMatrix", "[", 
             RowBox[{"Length", "[", "sym", "]"}], "]"}]}]}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "metropolisAdaptive", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"AdaptDelay", "->", "20"}], ",", 
       RowBox[{"Eps", "->", "1.*^-4"}], ",", 
       RowBox[{"InitCov", "->", "Automatic"}], ",", 
       RowBox[{"PrintEvery", "->", "20"}], ",", 
       RowBox[{"(*", 
        RowBox[{"Previously", " ", "1000"}], "*)"}], 
       RowBox[{"TargetAcc", "->", "0.25"}], ",", 
       RowBox[{"(*", 
        RowBox[{"Previously", " ", "0.234"}], "*)"}], 
       RowBox[{"AccWindow", "->", "1000"}], ",", 
       RowBox[{"AccTol", "->", "0.02"}], ",", 
       RowBox[{"Gamma0", "->", "1"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Initial", " ", "learning"}], "-", 
         RowBox[{"rate", " ", "numerator"}]}], "*)"}], 
       RowBox[{"GammaAlpha", "->", "0.6"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Exponent", " ", "in", " ", "gamma_t"}], "=", 
         RowBox[{"Gamma0", "/", 
          RowBox[{"t", "^", "GammaAlpha"}]}]}], "*)"}], 
       RowBox[{"MinAdaptIters", "->", "20000"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "Minimum", " ", "adaptation", " ", "updates", " ", "before", " ", 
         "stopping"}], "*)"}], 
       RowBox[{"ConsecOK", "->", "10"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "Consecutive", " ", "acceptable", " ", "windows", " ", "required", " ",
          "to", " ", "stop"}], "*)"}], 
       RowBox[{"LambdaRange", "->", 
        RowBox[{"{", 
         RowBox[{"0.01", ",", "5."}], "}"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"Allowed", " ", "lambda", " ", "interval"}], "*)"}], 
       RowBox[{"MaxAdaptIters", "->", "Infinity"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"metropolisAdaptive", "[", 
      RowBox[{
       RowBox[{"init_", "?", "VectorQ"}], ",", 
       RowBox[{"nsamples_Integer", "?", "Positive"}], ",", 
       RowBox[{"opts", ":", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], "/;", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"init", ",", "NumericQ"}], "]"}]}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dim", "=", 
         RowBox[{"Length", "[", "init", "]"}]}], ",", "s", ",", "chain", ",", 
        RowBox[{"current", "=", "init"}], ",", "currentLogPost", ",", 
        "proposalCov", ",", "proposalDist", ",", "prop", ",", "propLogPost", ",",
         "logA", ",", "u", ",", 
        RowBox[{"accepted", "=", "0"}], ",", "i", ",", "empCov", ",", 
        "baseCov", ",", 
        RowBox[{"adaptDelay", "=", 
         RowBox[{"OptionValue", "[", "AdaptDelay", "]"}]}], ",", 
        RowBox[{"eps", "=", 
         RowBox[{"OptionValue", "[", "Eps", "]"}]}], ",", 
        RowBox[{"initCov", "=", 
         RowBox[{"OptionValue", "[", "InitCov", "]"}]}], ",", 
        RowBox[{"printEvery", "=", 
         RowBox[{"OptionValue", "[", "PrintEvery", "]"}]}], ",", 
        RowBox[{"target", "=", 
         RowBox[{"OptionValue", "[", "TargetAcc", "]"}]}], ",", 
        RowBox[{"accWindow", "=", 
         RowBox[{"OptionValue", "[", "AccWindow", "]"}]}], ",", 
        RowBox[{"accTol", "=", 
         RowBox[{"OptionValue", "[", "AccTol", "]"}]}], ",", 
        RowBox[{"gamma0", "=", 
         RowBox[{"OptionValue", "[", "Gamma0", "]"}]}], ",", 
        RowBox[{"gammaAlpha", "=", 
         RowBox[{"OptionValue", "[", "GammaAlpha", "]"}]}], ",", 
        RowBox[{"minAdaptIters", "=", 
         RowBox[{"OptionValue", "[", "MinAdaptIters", "]"}]}], ",", 
        RowBox[{"consecOK", "=", 
         RowBox[{"OptionValue", "[", "ConsecOK", "]"}]}], ",", 
        RowBox[{"lambdaRange", "=", 
         RowBox[{"OptionValue", "[", "LambdaRange", "]"}]}], ",", 
        RowBox[{"maxAdaptIters", "=", 
         RowBox[{"OptionValue", "[", "MaxAdaptIters", "]"}]}], ",", 
        RowBox[{"lambda", "=", "1"}], ",", 
        RowBox[{"adaptOn", "=", "True"}], ",", 
        RowBox[{"adaptUpdates", "=", "0"}], ",", "acceptHistory", ",", 
        RowBox[{"historyLen", "=", "0"}], ",", 
        RowBox[{"historyPos", "=", "1"}], ",", "acceptedFlag", ",", 
        RowBox[{"consecOKcount", "=", "0"}], ",", "finalProposalCov", ",", 
        RowBox[{"globalAccRate", "=", "0."}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"s", "=", 
        RowBox[{
         RowBox[{"2.38", "^", "2"}], "/", "dim"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", 
           RowBox[{"IntegerQ", "[", "adaptDelay", "]"}]}], "||", 
          RowBox[{"adaptDelay", "<", "1"}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"metropolisAdaptive", "::", "badDelay"}], ",", 
            "adaptDelay"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"adaptDelay", "=", "100"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"accWindow", "<", "1"}], ",", 
         RowBox[{"accWindow", "=", "1"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"gamma0", "<=", "0"}], ",", 
         RowBox[{"gamma0", "=", "0.02"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"gammaAlpha", "<=", "0"}], ",", 
         RowBox[{"gammaAlpha", "=", "0.6"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"baseCov", "=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"MatrixQ", "[", "initCov", "]"}], "&&", 
           RowBox[{
            RowBox[{"Dimensions", "[", "initCov", "]"}], "===", 
            RowBox[{"{", 
             RowBox[{"dim", ",", "dim"}], "}"}]}]}], ",", "initCov", ",", 
          RowBox[{"initCov", "===", "Automatic"}], ",", 
          RowBox[{"eps", " ", 
           RowBox[{"IdentityMatrix", "[", "dim", "]"}]}], ",", "True", ",", 
          RowBox[{"eps", " ", 
           RowBox[{"IdentityMatrix", "[", "dim", "]"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"baseCov", "=", 
        RowBox[{"makePositiveDefinite", "[", 
         RowBox[{"baseCov", ",", 
          RowBox[{"10", "^", 
           RowBox[{"-", "12"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"chain", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.", ",", 
          RowBox[{"{", 
           RowBox[{"nsamples", ",", "dim"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"chain", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", "current"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"currentLogPost", "=", 
        RowBox[{"logposterior", "[", "current", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"acceptHistory", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", "accWindow"}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "Circular", " ", "buffer", " ", "of", " ", "recent", " ", 
         "acceptances"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"historyLen", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"historyPos", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"finalProposalCov", "=", 
        RowBox[{"s", " ", "baseCov"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Monitor", "[", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"adaptOn", "&&", 
               RowBox[{
                RowBox[{"i", "-", "1"}], ">=", "2"}], "&&", 
               RowBox[{"i", ">", 
                RowBox[{"adaptDelay", "+", "1"}]}]}], ",", 
              RowBox[{
               RowBox[{"empCov", "=", 
                RowBox[{"Covariance", "[", 
                 RowBox[{"Take", "[", 
                  RowBox[{"chain", ",", 
                   RowBox[{"i", "-", "1"}]}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"!", 
                   RowBox[{"MatrixQ", "[", "empCov", "]"}]}], "||", 
                  RowBox[{
                   RowBox[{"Dimensions", "[", "empCov", "]"}], "=!=", 
                   RowBox[{"{", 
                    RowBox[{"dim", ",", "dim"}], "}"}]}]}], ",", 
                 RowBox[{"empCov", "=", "baseCov"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"proposalCov", "=", 
                RowBox[{"makePositiveDefinite", "[", 
                 RowBox[{
                  RowBox[{"lambda", " ", "s", " ", 
                   RowBox[{"(", 
                    RowBox[{"empCov", "+", 
                    RowBox[{"eps", " ", 
                    RowBox[{"IdentityMatrix", "[", "dim", "]"}]}]}], ")"}]}], 
                  ",", 
                  RowBox[{"10", "^", 
                   RowBox[{"-", "12"}]}]}], "]"}]}], ";", 
               RowBox[{"(*", 
                RowBox[{"Adaptive", " ", "proposal", " ", "covariance"}], 
                "*)"}], 
               RowBox[{"finalProposalCov", "=", "proposalCov"}]}], ",", 
              RowBox[{"proposalCov", "=", "finalProposalCov"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"proposalDist", "=", 
             RowBox[{"MultinormalDistribution", "[", 
              RowBox[{"current", ",", "proposalCov"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"prop", "=", 
             RowBox[{"RandomVariate", "[", "proposalDist", "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"AnyTrue", "[", 
                RowBox[{"prop", ",", 
                 RowBox[{
                  RowBox[{"#", "<", "0"}], "&"}]}], "]"}], "||", 
               RowBox[{
                RowBox[{"prop", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "<", "0.01"}]}], ",", 
              RowBox[{"(*", 
               RowBox[{
               "Reject", " ", "proposals", " ", "containing", " ", "negative",
                 " ", "elements"}], "*)"}], 
              RowBox[{"acceptedFlag", "=", "0"}], ",", 
              RowBox[{"(*", 
               RowBox[{
               "Otherwise", " ", "evaluate", " ", "the", " ", "log", " ", 
                "posterior"}], "*)"}], 
              RowBox[{
               RowBox[{"propLogPost", "=", 
                RowBox[{"TimeConstrained", "[", 
                 RowBox[{
                  RowBox[{"logposterior", "[", "prop", "]"}], ",", "5", ",", 
                  "$TimedOut"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"propLogPost", "===", "$TimedOut"}], ",", 
                 RowBox[{
                  RowBox[{"acceptedFlag", "=", "0"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"Print", "[", 
                   
                   RowBox[{"\"\<TIMEOUT at iteration \>\"", ",", "i", 
                    ",", "\"\< | prop = \>\"", ",", 
                    RowBox[{"InputForm", "[", "prop", "]"}]}], "]"}]}], ",", 
                 RowBox[{
                  RowBox[{"logA", "=", 
                   RowBox[{"propLogPost", "-", "currentLogPost"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"u", "=", 
                   RowBox[{"Log", "[", 
                    RowBox[{"RandomReal", "[", "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"u", "<", 
                    RowBox[{"Min", "[", 
                    RowBox[{"0", ",", "logA"}], "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"current", "=", "prop"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"currentLogPost", "=", "propLogPost"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"acceptedFlag", "=", "1"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"accepted", "++"}]}], ",", 
                    RowBox[{"acceptedFlag", "=", "0"}]}], "]"}]}]}], 
                "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"chain", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "=", "current"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"acceptHistory", "[", 
              RowBox[{"[", "historyPos", "]"}], "]"}], "=", "acceptedFlag"}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"historyPos", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"historyPos", "==", "accWindow"}], ",", "1", ",", 
               RowBox[{"historyPos", "+", "1"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"historyLen", "=", 
             RowBox[{"Min", "[", 
              RowBox[{
               RowBox[{"historyLen", "+", "1"}], ",", "accWindow"}], "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"adaptOn", "&&", 
               RowBox[{"i", ">", 
                RowBox[{"adaptDelay", "+", "1"}]}]}], ",", 
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"accWindowRate", ",", "gammaT"}], "}"}], ",", 
                RowBox[{
                 RowBox[{"accWindowRate", "=", 
                  RowBox[{"N", "[", 
                   RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{"Take", "[", 
                    RowBox[{"acceptHistory", ",", "historyLen"}], "]"}], 
                    "]"}], "/", "historyLen"}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"adaptUpdates", "++"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"adaptUpdates", ">", "maxAdaptIters"}], ",", 
                   RowBox[{"adaptOn", "=", "False"}], ",", 
                   RowBox[{
                    RowBox[{"gammaT", "=", 
                    RowBox[{"gamma0", "/", 
                    RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"1", ",", "adaptUpdates"}], "]"}], "^", 
                    "gammaAlpha"}]}]}], ";", 
                    RowBox[{"(*", 
                    RowBox[{"Diminishing", " ", "adaptation", " ", "rate"}], 
                    "*)"}], 
                    RowBox[{"lambda", "=", 
                    RowBox[{"lambda", " ", 
                    RowBox[{"Exp", "[", 
                    RowBox[{"gammaT", " ", 
                    RowBox[{"(", 
                    RowBox[{"accWindowRate", "-", "target"}], ")"}]}], 
                    "]"}]}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"lambda", "=", 
                    RowBox[{"Clip", "[", 
                    RowBox[{"lambda", ",", "lambdaRange"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"adaptUpdates", ">=", "minAdaptIters"}], "&&", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"accWindowRate", "-", "target"}], "]"}], "<=", 
                    "accTol"}]}], ",", 
                    RowBox[{"consecOKcount", "++"}], ",", 
                    RowBox[{"consecOKcount", "=", "0"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"consecOKcount", ">=", "consecOK"}], ",", 
                    RowBox[{"adaptOn", "=", "False"}]}], 
                    "                                               ", 
                    RowBox[{"(*", 
                    RowBox[{
                    "Stop", " ", "after", " ", "enough", " ", "acceptable", " ",
                     "windows"}], "*)"}], "]"}]}]}], "]"}]}]}], "]"}]}], 
             "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"IntegerQ", "[", "printEvery", "]"}], "&&", 
               RowBox[{"printEvery", ">", "0"}], "&&", 
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{"i", ",", "printEvery"}], "]"}], "==", "0"}]}], ",", 
              RowBox[{"Export", "[", 
               RowBox[{"\"\<currentMCMC4.mx\>\"", ",", "chain"}], "]"}]}], 
             "                              ", 
             RowBox[{"(*", 
              RowBox[{"Periodic", " ", "checkpoint"}], "*)"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "2", ",", "nsamples"}], "}"}]}], "]"}], ",", 
         RowBox[{"Dynamic", "[", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"winAcc", ",", "gAcc"}], "}"}], ",", 
            RowBox[{
             RowBox[{"winAcc", "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"historyLen", ">", "0"}], ",", 
                RowBox[{"N", "[", 
                 RowBox[{
                  RowBox[{"Total", "[", 
                   RowBox[{"Take", "[", 
                    RowBox[{"acceptHistory", ",", "historyLen"}], "]"}], 
                   "]"}], "/", "historyLen"}], "]"}], ",", "0."}], "]"}]}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"gAcc", "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"i", ">", "1"}], ",", 
                RowBox[{"N", "[", 
                 RowBox[{"accepted", "/", 
                  RowBox[{"(", 
                   RowBox[{"i", "-", "1"}], ")"}]}], "]"}], ",", "0."}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<Iteration: \>\"", ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"ValueQ", "[", "i", "]"}], ",", "i", ",", "1"}], 
                 "]"}], ",", "\"\< | Global acc: \>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{"gAcc", ",", 
                  RowBox[{"{", 
                   RowBox[{"4", ",", "3"}], "}"}]}], "]"}], 
                ",", "\"\< | Window acc(\>\"", ",", "historyLen", 
                ",", "\"\<): \>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{"winAcc", ",", 
                  RowBox[{"{", 
                   RowBox[{"4", ",", "3"}], "}"}]}], "]"}], 
                ",", "\"\< | adapting?: \>\"", ",", "adaptOn", 
                ",", "\"\< | lambda: \>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{"lambda", ",", 
                  RowBox[{"{", 
                   RowBox[{"5", ",", "4"}], "}"}]}], "]"}]}], "}"}], 
              "]"}]}]}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Chain\>\"", "->", "chain"}], ",", 
         RowBox[{"\"\<AcceptanceRate\>\"", "->", 
          RowBox[{"N", "[", 
           RowBox[{"accepted", "/", 
            RowBox[{"(", 
             RowBox[{"nsamples", "-", "1"}], ")"}]}], "]"}]}], ",", 
         RowBox[{"\"\<FinalProposalCov\>\"", "->", "finalProposalCov"}], ",", 
         RowBox[{"\"\<FinalLambda\>\"", "->", "lambda"}], ",", 
         RowBox[{"\"\<AdaptStopped\>\"", "->", 
          RowBox[{"!", "adaptOn"}]}], ",", 
         RowBox[{"\"\<AdaptUpdates\>\"", "->", "adaptUpdates"}]}], "|>"}]}]}],
      "]"}]}]}]}]], "Input",
