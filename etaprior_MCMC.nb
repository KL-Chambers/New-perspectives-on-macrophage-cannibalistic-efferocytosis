Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Negative", " ", "binomial", " ", "PMF"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"negbinom", "[", 
      RowBox[{"i_", ",", "\[Mu]_", ",", "cv_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "p"}], "}"}], ",", 
       RowBox[{
        RowBox[{"r", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Mu]", "-", "1"}], ")"}], "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"cv", "^", "2"}], "*", 
             RowBox[{"\[Mu]", "^", "2"}]}], "-", "\[Mu]", "+", "1"}], 
           ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"p", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Mu]", "-", "1"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"cv", "^", "2"}], "*", 
            RowBox[{"\[Mu]", "^", "2"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{
           RowBox[{"i", "+", "r", "-", "2"}], ",", 
           RowBox[{"i", "-", "1"}]}], "]"}], "*", 
         RowBox[{"p", "^", "r"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "p"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"i", "-", "1"}], ")"}]}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Posterior", " ", "samples"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thin", "=", "100"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"muSamples", "=", 
     RowBox[{"100", 
      RowBox[{"vars", "[", 
       RowBox[{"[", 
        RowBox[{"3", ",", 
         RowBox[{"1", ";;", "All", ";;", "thin"}]}], "]"}], "]"}]}]}], ";"}], 
   "   ", 
   RowBox[{"(*", "mu_f", "*)"}], "\n", 
   RowBox[{
    RowBox[{"cvSamples", "=", 
     RowBox[{"vars", "[", 
      RowBox[{"[", 
       RowBox[{"4", ",", 
        RowBox[{"1", ";;", "All", ";;", "thin"}]}], "]"}], "]"}]}], ";"}], 
   "   ", 
   RowBox[{"(*", "cv_f", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Range", " ", "of", " ", "i", " ", "values", " ", "to", " ", "plot"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"iMax", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"iVals", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", "iMax"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "PMF", " ", "for", " ", "every", " ", "posterior", " ", "sample"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"pmfSamples", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"negbinom", "[", 
        RowBox[{"i", ",", 
         RowBox[{"muSamples", "[", 
          RowBox[{"[", "s", "]"}], "]"}], ",", 
         RowBox[{"cvSamples", "[", 
          RowBox[{"[", "s", "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", 
         RowBox[{"Length", "[", "muSamples", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "iVals"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Posterior", " ", "summaries", " ", "at", " ", "each", " ", "i"}],
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"pmfMean", "=", 
     RowBox[{"Mean", "/@", 
      RowBox[{"Transpose", "[", "pmfSamples", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"pmfCI", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Quantile", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"0.05", ",", "0.95"}], "}"}]}], "]"}], "&"}], "/@", 
      RowBox[{"Transpose", "[", "pmfSamples", "]"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.997966096481224*^9, 3.9979661711983204`*^9}, {
