         RowBox[{"(*", 
          RowBox[{"{", 
           RowBox[{"0", ",", "All"}], "}"}], "*)"}], "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameTicks", "->", "Automatic"}], ",", 
       RowBox[{"ImageSize", "->", "img"}], ",", 
       RowBox[{"BaseStyle", "->", 
        RowBox[{"{", 
         RowBox[{"FontFamily", "->", "\"\<Cambria Math\>\""}], "}"}]}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"{", 
         RowBox[{
