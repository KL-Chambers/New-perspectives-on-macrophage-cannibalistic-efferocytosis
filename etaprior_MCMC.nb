  RowBox[{
   RowBox[{
    RowBox[{"burnin", "=", "0"}], ";"}], "    ", "\n", 
   RowBox[{
    RowBox[{"thin", "=", "1"}], ";"}], "              ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"posteriorChains", "=", 
