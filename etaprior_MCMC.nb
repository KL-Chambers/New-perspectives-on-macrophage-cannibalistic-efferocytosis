           RowBox[{"Labeled", "[", 
            RowBox[{"p", ",", 
             RowBox[{"names", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "Left"}], "]"}]}]}], "]"}],
         ";", "p"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"labeledGrid", "=", 
     RowBox[{"MapIndexed", "[", 
